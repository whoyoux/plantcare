{
  "name": "@plantcare/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "auth:schema": "auth generate --config scripts/auth-schema.config.ts --output src/schema/auth.ts --yes",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@better-auth/expo": "^1.7.7",
    "@plantcare/tsconfig": "workspace:*",
    "auth": "^1.7.7",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@plantcare/eslint-config": "workspace:*"
  }
}
