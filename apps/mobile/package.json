  "devDependencies": {
    "@plantcare/tsconfig": "workspace:*",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.5",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client",
    "dev:tunnel": "APP_VARIANT=development expo start --dev-client --tunnel",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview",
    "build:prod": "eas build --platform ios --profile production",
    "device:add": "eas device:create",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "icons": "node scripts/generate-icons.mjs",
    "icons:artwork": "node --env-file-if-exists=.env.icons.local scripts/generate-icon-artwork.mjs"
