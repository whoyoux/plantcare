{
  "name": "@plantcare/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@better-auth/expo": "^1.7.7",
    "@expo/ui": "~58.0.20",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@plantcare/shared": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@tanstack/react-query": "^5.104.2",
    "better-auth": "catalog:",
    "expo": "~58.0.14",
    "expo-apple-authentication": "~58.0.2",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.10",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "~58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.4",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.17",
    "expo-web-browser": "~58.0.6",
    "expo-widgets": "~58.0.20",
    "hono": "catalog:",
    "i18next": "^26.4.4",
    "react": "catalog:",
    "react-i18next": "^17.0.16",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-fetch": "^1.9.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@plantcare/api": "workspace:*",
    "@plantcare/tsconfig": "workspace:*",
    "@types/react": "~19.3.0",
    "eslint": "catalog:",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "sharp": "^0.35.5",
    "typescript": "catalog:"
  },
  "scripts": {
    "dev": "APP_VARIANT=development expo start --dev-client",
    "dev:tunnel": "APP_VARIANT=development expo start --dev-client --tunnel",
    "build:dev": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform ios --profile preview --auto-submit",
    "build:prod": "eas build --platform ios --profile production --auto-submit",
    "device:add": "eas device:create",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "icons": "node scripts/generate-icons.mjs",
    "icons:artwork": "node --env-file-if-exists=.env.icons.local scripts/generate-icon-artwork.mjs",
    "build:preview:local": "EAS_LOCAL_BUILD_WORKINGDIR=$HOME/.cache/eas-local-build eas build --platform ios --profile preview --local --output build/plantcare-preview.ipa && APP_VARIANT=preview eas submit --platform ios --profile preview --path build/plantcare-preview.ipa",
    "build:prod:local": "EAS_LOCAL_BUILD_WORKINGDIR=$HOME/.cache/eas-local-build eas build --platform ios --profile production --local --output build/plantcare-production.ipa && APP_VARIANT=production eas submit --platform ios --profile production --path build/plantcare-production.ipa",
    "update:preview": "APP_VARIANT=preview eas update --channel preview --environment preview",
    "update:prod": "APP_VARIANT=production eas update --channel production --environment production"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-fetch"
        ]
      }
    }
  }
}
